<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      Cadena de conexión a SQL Server. Cambie solo el valor de Server según su equipo:
        SQL Server Express:      localhost\SQLEXPRESS
        SQL Server (instancia por defecto):  localhost    (o  .  )
        LocalDB de Visual Studio: (localdb)\MSSQLLocalDB
      Si usa usuario y contraseña de SQL Server en vez de autenticación de Windows, reemplace
      Trusted_Connection=True por  User Id=su_usuario;Password=su_clave;
    -->
    <add name="BibliotecaDB"
         connectionString="Server=localhost\SQLEXPRESS;Database=BibliotecaDB;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
