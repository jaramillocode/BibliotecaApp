erDiagram
    AUTORES ||--o{ LIBROS : escribe
    EDITORIALES ||--o{ LIBROS : publica
    USUARIOS ||--o{ PRESTAMOS : solicita
    LIBROS ||--o{ PRESTAMOS : "se presta en"
